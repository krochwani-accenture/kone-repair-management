# Copy this file to .env.local and fill in your values
# This is for LOCAL DEVELOPMENT ONLY

# Lambda API URL (from SAM deployment)
# Format: https://<api-id>.execute-api.<region>.amazonaws.com/Prod
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Alternative repairs API URL (optional, uses NEXT_PUBLIC_API_URL if not set)
# NEXT_PUBLIC_REPAIRS_API_URL=https://your-lambda-api.execute-api.region.amazonaws.com/Prod
